}

.socials a{
text-decoration:none;
margin-left:15px;
font-weight:600;
color:#333;
}

.hero{
display:grid;
grid-template-columns:1fr 1fr;
gap:50px;
align-items:center;
padding:80px 0;
}

.badge{
display:inline-block;
background:#fff4e8;
color:#ff7a00;
padding:8px 18px;
border-radius:30px;
font-weight:600;
margin-bottom:20px;
}

.hero h1{
font-size:52px;
line-height:1.2;
margin-bottom:20px;
}

.hero ul{
list-style:none;
margin:25px 0;
}

.hero ul li{
margin-bottom:10px;
font-size:18px;
}

.hero-image img{
width:100%;
border-radius:24px;
box-shadow:0 10px 30px rgba(0,0,0,.1);
}

.section-title{
text-align:center;
margin-bottom:50px;
}

.section-title h2{
font-size:40px;
margin-bottom:10px;
}

.grid-4{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:25px;
}

.card{
padding:30px;
background:#fff;
border-radius:18px;
box-shadow:0 4px 20px rgba(0,0,0,.06);
}

.card h3{
margin:15px 0;
}

.grid-3{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:25px;
}

.routine{
max-width:700px;
margin:auto;
text-align:center;
}

.routine-item{
padding:15px;
margin-bottom:10px;
background:#fafafa;
border-radius:12px;
}

.quote{
font-size:24px;
font-weight:600;
margin-top:30px;
color:#ff7a00;
}

.vision{
background:#fff9f3;
}

.vision-content{
max-width:800px;
margin:auto;
text-align:center;
}

.coming-soon{
text-align:center;
}

.footer{
background:#1d1d1d;
color:#fff;
padding:50px 0;
text-align:center;
}

.footer p{
margin-top:10px;
color:#ddd;
}

.footer a{
color:#fff;
margin:0 10px;
text-decoration:none;
}

.whatsapp-float{
position:fixed;
bottom:20px;
right:20px;
background:#25D366;
color:white;
padding:15px 18px;
border-radius:50%;
font-size:24px;
text-decoration:none;
}

@media(max-width:900px){

.hero{
grid-template-columns:1fr;
}

.grid-4{
grid-template-columns:1fr 1fr;
}

.grid-3{
grid-template-columns:1fr;
}

.hero h1{
font-size:38px;
}

.section-title h2{
font-size:30px;
}
}

@media(max-width:600px){

.grid-4{
grid-template-columns:1fr;
}

.logo{
font-size:22px;
}

.socials{
display:none;
}
}

